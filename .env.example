# Copy this file to .env and fill in what you have. Everything is optional:
# the dashboard runs with whatever is configured and shows setup hints for the rest.

PORT=3000

# ── Refresh intervals ───────────────────────────────────────────────
# News is free, so it refreshes often. Social scrapes are paid per result on
# Apify. These defaults cost roughly US$1/day (~$30/month); run `npm run check`
# to see the estimate for your settings. Every 30 min would be ~$25/day.
NEWS_REFRESH_MINUTES=3
SOCIAL_REFRESH_MINUTES=720
TRENDS_REFRESH_MINUTES=1440

# ── YouTube (FREE, official) ─────────────────────────────────────────
# YouTube's official "trending in Malaysia" chart + trending music videos.
# Free key: see README → "Get a free YouTube API key". Uses ~100 of the
# 10,000 free daily quota units at the default 30-minute refresh.
YOUTUBE_API_KEY=
YOUTUBE_REFRESH_MINUTES=30

# Google Trends "trending searches" in Malaysia is always on (free, no key).
SEARCH_TRENDS_REFRESH_MINUTES=10

# ── Apify (recommended: one token powers TikTok, Instagram and Facebook) ──
# Get it at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# TikTok — clockworks/tiktok-scraper, searched from a Malaysian proxy
TIKTOK_SEARCH_QUERIES=viral malaysia,trending malaysia,malaysia
TIKTOK_HASHTAGS=viralmalaysia,fypmalaysia
TIKTOK_RESULTS_PER_QUERY=10
# MOST_RELEVANT (cheapest) | MOST_LIKED | LATEST (each +$0.0013/result)
TIKTOK_SORT=MOST_RELEVANT
# PAST_24_HOURS | PAST_WEEK | PAST_MONTH
TIKTOK_DATE_FILTER=PAST_24_HOURS

# TikTok official trend lists (Creative Center / Explore) — automation-lab/tiktok-trends-scraper
TIKTOK_TRENDS_ENABLED=true

# Instagram — apify/instagram-hashtag-scraper (Reels include music info)
IG_HASHTAGS=viralmalaysia,malaysiaviral,reelsmalaysia
IG_RESULTS_LIMIT=10

# Facebook — apify/facebook-posts-scraper over these public pages (edit freely)
FB_PAGES=https://www.facebook.com/thestaronline,https://www.facebook.com/malaysiakini,https://www.facebook.com/hmetromy,https://www.facebook.com/worldofbuzz
FB_RESULTS_PER_PAGE=5

# ── Jobs tab ────────────────────────────────────────────────────────
# LinkedIn, JobStreet, Indeed, Maukerja and Hiredly have no public job-search
# APIs. Each site is reached a different way (see README → "Jobs"):
#   google     SerpApi Google Jobs: FREE 250 searches/month. Also covers Maukerja, Hiredly…
#   careerjet  Careerjet API: FREE publisher key
#   jobstreet  Apify (uses APIFY_TOKEN): ~$0.002/job + $0.01 per search
#   linkedin   Apify (uses APIFY_TOKEN): ~$0.002/job
#   indeed     Apify (uses APIFY_TOKEN): ~$0.0001/job
JOB_SOURCES=jobstreet,linkedin,indeed,google,careerjet
# One search per entry, on every enabled site
JOB_QUERIES=executive,software engineer,marketing
JOB_LOCATION=Malaysia
# Optional: narrow to a city/state, e.g. Kuala Lumpur, Selangor, Penang
JOB_CITY=
JOB_RESULTS_PER_QUERY=10
JOB_POSTED_WITHIN_DAYS=7
# Google Jobs and the Apify sites refresh on this (paid/quota) interval.
# 3 queries × 1/day = ~90 of SerpApi's 250 free searches a month.
JOBS_REFRESH_MINUTES=1440
# Careerjet is free and unmetered
JOBS_FREE_REFRESH_MINUTES=360

SERPAPI_KEY=
CAREERJET_API_KEY=
# Careerjet requires the end user's IP; your own public IP is fine.
CAREERJET_USER_IP=

# ── Meta Graph API (optional fallback if you don't use Apify) ───────
# Instagram hashtag search needs an Instagram Business/Creator account linked
# to a Facebook Page, plus the instagram_basic permission.
IG_GRAPH_TOKEN=
IG_BUSINESS_USER_ID=
# Facebook page posts: works for pages you manage, or any public page if your
# app has "Page Public Content Access". Comma-separated page IDs or usernames.
FB_GRAPH_TOKEN=
FB_GRAPH_PAGES=

# ── News (optional, adds NewsAPI headlines on top of the free RSS feeds) ──
NEWSAPI_KEY=
